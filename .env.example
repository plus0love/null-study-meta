# 서버 포트 (Render 가 자동 주입하므로 로컬에서만 필요)
PORT=3000

# 저장소 선택: memory | supabase
# 비워두면 SUPABASE_URL + SUPABASE_SERVICE_KEY 가 있을 때 supabase, 없으면 memory 로 자동 선택
# (테스트는 항상 memory 로 강제됨)
STORE=

# Supabase 프로젝트 설정 → API 에서 확인
# service_role 키는 서버에서만 사용 (절대 클라이언트에 노출 금지)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# 통계 시간대 (오늘/이번 주/출석 경계 = 이 시간대의 0시·월요일). 기본 Asia/Seoul
STATS_TZ=Asia/Seoul

# 방 전체 비밀번호 (6단계). 비워두면 누구나 입장.
# 서버는 시작 시 해시만 들고 비교하며 평문을 로그에 남기지 않는다. 5회 틀리면 IP 별 30초 잠금.
ROOM_PASSWORD=
